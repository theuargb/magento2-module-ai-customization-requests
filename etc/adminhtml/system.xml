<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="perspective_ai_customization" translate="label" sortOrder="950" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Perspective AI Customization</label>
            <tab>general</tab>
            <resource>Perspective_AiCustomizationRequests::config</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Module</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="widget" translate="label" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Widget content</label>
                <field id="title" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>Assistant name</label></field>
                <field id="icon" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Assistant icon</label><comment>A short character or emoji shown in the launcher and header.</comment></field>
                <field id="logo" translate="label" type="image" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Assistant logo</label><backend_model>Magento\Config\Model\Config\Backend\Image</backend_model><upload_dir config="system/filesystem/media" scope_info="1">perspective/ai_customization</upload_dir><base_url type="media" scope_info="1">perspective/ai_customization</base_url><comment>Optional. Overrides the icon when set.</comment></field>
                <field id="close_label" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Close button label</label></field>
                <field id="clear_label" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>New chat label</label></field>
                <field id="input_placeholder" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1"><label>Message placeholder</label></field>
                <field id="send_label" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"><label>Send button label</label></field>
                <field id="helper_text" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1"><label>Composer helper text</label></field>
                <field id="user_label" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1"><label>Customer message label</label></field>
                <field id="context_label" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1"><label>Selected product label</label></field>
                <field id="context_remove_label" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1"><label>Remove selection label</label></field>
                <field id="product_label" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1"><label>Product match label</label></field>
                <field id="product_ask_label" translate="label" type="text" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1"><label>Ask about product label</label></field>
                <field id="product_view_label" translate="label" type="text" sortOrder="140" showInDefault="1" showInWebsite="1" showInStore="1"><label>View product label</label></field>
            </group>

            <group id="widget_welcome" translate="label" sortOrder="16" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Widget welcome screen</label>
                <field id="welcome_eyebrow" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>Eyebrow</label></field>
                <field id="welcome_title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Heading</label></field>
                <field id="welcome_copy" translate="label" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Description</label></field>
                <field id="prompt_one_label" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>First suggestion label</label></field>
                <field id="prompt_one_text" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>First suggestion text</label></field>
                <field id="prompt_two_label" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1"><label>Second suggestion label</label></field>
                <field id="prompt_two_text" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"><label>Second suggestion text</label></field>
                <field id="prompt_three_label" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1"><label>Third suggestion label</label></field>
                <field id="prompt_three_text" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1"><label>Third suggestion text</label></field>
            </group>

            <group id="widget_messages" translate="label" sortOrder="17" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Widget states and errors</label>
                <field id="status_connecting" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>Connecting status</label></field>
                <field id="status_ready" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Ready status</label></field>
                <field id="status_thinking" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Thinking status</label></field>
                <field id="status_unavailable" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Unavailable status</label></field>
                <field id="status_message_failed" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>Message failed status</label></field>
                <field id="error_eyebrow" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1"><label>Error eyebrow</label></field>
                <field id="error_title" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"><label>Error heading</label></field>
                <field id="error_copy" translate="label" type="textarea" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1"><label>Error description</label></field>
                <field id="error_retry_label" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1"><label>Retry label</label></field>
                <field id="message_send_error" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1"><label>Send error message</label></field>
            </group>

            <group id="widget_appearance" translate="label" sortOrder="18" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Widget appearance</label>
                <comment>Enter six-digit hexadecimal colours, for example #1463D9.</comment>
                <field id="primary_color" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>Primary colour</label></field>
                <field id="primary_hover_color" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Primary hover colour</label></field>
                <field id="on_primary_color" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Text on primary colour</label></field>
                <field id="icon_background_color" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Icon background colour</label></field>
                <field id="icon_foreground_color" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>Icon colour</label></field>
                <field id="surface_color" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1"><label>Surface colour</label></field>
                <field id="canvas_color" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"><label>Conversation background colour</label></field>
                <field id="text_color" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1"><label>Text colour</label></field>
                <field id="muted_color" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1"><label>Muted text colour</label></field>
                <field id="border_color" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1"><label>Border colour</label></field>
            </group>

            <group id="openrouter" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>OpenRouter</label>
                <field id="api_key" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="site_url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Site URL Header</label>
                </field>
                <field id="site_title" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Site Title Header</label>
                </field>
            </group>

            <group id="agent" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Agent</label>
                <field id="chat_model" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Chat Model</label>
                </field>
                <field id="embedding_model" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Embedding Model</label>
                </field>
                <field id="max_iterations" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Max Tool Iterations</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="http_timeout" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>HTTP Timeout</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="max_message_length" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Maximum Message Length</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="session_ttl_hours" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Session Lifetime (Hours)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="opensearch" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>OpenSearch</label>
                <field id="host" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Host Override</label>
                    <comment>Leave empty to reuse catalog search OpenSearch host.</comment>
                </field>
                <field id="port" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Port Override</label>
                </field>
                <field id="index_name" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>AI Index Name</label>
                </field>
                <field id="username" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Username Override</label>
                </field>
                <field id="password" translate="label" type="obscure" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Password Override</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="vector_dimensions" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Vector Dimensions</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="batch_size" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Index Batch Size</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="email" translate="label" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Email</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Send Customer Emails</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="sender_identity" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sender Identity</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                </field>
                <field id="approve_template" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Approval Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
                <field id="decline_template" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Decline Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
