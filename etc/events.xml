<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="perspective_ai_queue_saved_product" instance="Perspective\AiCustomizationRequests\Observer\QueueProductForIndexing"/>
    </event>
    <event name="catalog_product_delete_after_done">
        <observer name="perspective_ai_queue_deleted_product" instance="Perspective\AiCustomizationRequests\Observer\QueueDeletedProductForIndexing"/>
    </event>
    <event name="catalog_category_save_after">
        <observer name="perspective_ai_invalidate_index_after_category_save" instance="Perspective\AiCustomizationRequests\Observer\InvalidateIndexerOnCategoryChange"/>
    </event>
    <event name="catalog_category_delete_after_done">
        <observer name="perspective_ai_invalidate_index_after_category_delete" instance="Perspective\AiCustomizationRequests\Observer\InvalidateIndexerOnCategoryChange"/>
    </event>
</config>
