<?xml version="1.0" ?>
<config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd"
>
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource
                    id="Perspective_AiCustomizationRequests::ai_requests"
                    title="AI Customization Requests"
                    sortOrder="80"
                >
                    <resource
                        id="Perspective_AiCustomizationRequests::requests"
                        title="Requests"
                        sortOrder="10"
                    />
                    <resource
                        id="Perspective_AiCustomizationRequests::config"
                        title="Configuration"
                        sortOrder="20"
                    />
                    <resource
                        id="Perspective_AiCustomizationRequests::approve"
                        title="Approve Requests"
                        sortOrder="30"
                    />
                    <resource
                        id="Perspective_AiCustomizationRequests::decline"
                        title="Decline Requests"
                        sortOrder="40"
                    />
                </resource>
            </resource>
        </resources>
    </acl>
</config>
