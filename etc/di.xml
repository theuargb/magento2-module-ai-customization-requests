<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Perspective\AiCustomizationRequests\Model\Agent\ToolExecutor">
        <arguments>
            <argument name="tools" xsi:type="array">
                <item name="search_catalog" xsi:type="object">Perspective\AiCustomizationRequests\Model\Agent\Tool\SearchCatalogTool</item>
                <item name="get_product_context" xsi:type="object">Perspective\AiCustomizationRequests\Model\Agent\Tool\GetProductContextTool</item>
                <item name="save_customer_email" xsi:type="object">Perspective\AiCustomizationRequests\Model\Agent\Tool\SaveCustomerEmailTool</item>
                <item name="upsert_customization_request" xsi:type="object">Perspective\AiCustomizationRequests\Model\Agent\Tool\UpsertCustomizationRequestTool</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="perspective_ai_request_listing_data_source" xsi:type="string">Perspective\AiCustomizationRequests\Model\ResourceModel\CustomizationRequest\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <type name="Perspective\AiCustomizationRequests\Model\ResourceModel\CustomizationRequest\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">perspective_ai_customization_request</argument>
            <argument name="eventPrefix" xsi:type="string">perspective_ai_request_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">request_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Perspective\AiCustomizationRequests\Model\ResourceModel\CustomizationRequest</argument>
        </arguments>
    </type>
</config>
