type Query {
    aiChatConfig: AiChatConfig
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\AiChatConfig")
        @doc(description: "Returns storefront AI chat configuration.")
    aiChatSession(session_uid: String!): AiChatSession
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\AiChatSession")
        @doc(description: "Returns a persisted storefront AI chat session.")
}

type Mutation {
    startAiChatSession(input: StartAiChatSessionInput): AiChatSession!
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\StartAiChatSession")
        @doc(description: "Creates or restores an AI chat session.")
    sendAiChatMessage(input: SendAiChatMessageInput!): SendAiChatTurnOutput!
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\SendAiChatMessage")
        @doc(description: "Sends a chat message through the managed AI agent loop.")
    restoreAiDraftQuote(token: String!): RestoreAiDraftQuoteOutput!
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\RestoreAiDraftQuote")
        @doc(description: "Restores an approved draft quote into the active checkout session.")
}

input StartAiChatSessionInput {
    session_uid: String
    customer_email: String
}

input SendAiChatMessageInput {
    session_uid: String!
    message: String!
}

type AiChatConfig {
    enabled: Boolean!
    widget_title: String!
}

type AiChatSession {
    session_uid: String!
    customer_email: String
    request_uid: String
    messages: [AiChatMessage!]!
}

type AiChatMessage {
    role: String!
    content: String!
    message_type: String!
    product_mentions: [AiProductMention!]!
    created_at: String!
}

type AiProductMention {
    sku: String!
    name: String!
    url: String
    context_token: String!
}

type SendAiChatTurnOutput {
    session: AiChatSession!
    assistant_message: AiChatMessage!
    request_uid: String
}

type RestoreAiDraftQuoteOutput {
    success: Boolean!
    cart_url: String
    masked_cart_id: String
}
