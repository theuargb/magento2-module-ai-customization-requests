type Query {
    resumeAiChatSession(input: ResumeAiChatSessionInput!): AiChatSession!
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\ResumeAiChatSession")
        @doc(description: "Loads an AI chat session owned by the caller.")
}

type Mutation {
    startAiChatSession: AiChatSession!
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\StartAiChatSession")
        @doc(description: "Creates an AI chat session and returns its one-time resume token.")
    sendAiChatMessage(input: SendAiChatMessageInput!): AiChatTurn!
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\SendAiChatMessage")
        @doc(description: "Runs one chat turn. Retrying with the same client_message_id returns the stored reply.")
    restoreAiPreparedCart(token: String!): RestoreAiPreparedCartOutput!
        @resolver(class: "Perspective\\AiCustomizationRequests\\GraphQl\\Resolver\\RestoreAiPreparedCart")
        @doc(description: "Adds an approved customization to the caller's cart. The token is single-use.")
}

input ResumeAiChatSessionInput {
    session_uid: String!
    resume_token: String!
}

input SendAiChatMessageInput {
    session_uid: String!
    resume_token: String!
    client_message_id: String! @doc(description: "Idempotency key generated once per shopper message.")
    message: String!
    selected_product_sku: String @doc(description: "Product the shopper explicitly picked as context.")
    current_page_url: String
    guest_email: String @doc(description: "Required once for guest sessions without an email.")
}

type AiChatSession {
    session_uid: String!
    resume_token: String @doc(description: "Only returned by startAiChatSession.")
    request_uid: String @doc(description: "Latest customization request of the session.")
    email_required: Boolean!
    messages: [AiChatMessage!]!
}

type AiChatMessage {
    role: String! @doc(description: "user or assistant.")
    content: String!
    product_mentions: [AiProductMention!]!
    created_at: String!
}

type AiProductMention {
    sku: String!
    selected: Boolean!
    product: ProductInterface @resolver(class: "Magento\\CatalogGraphQl\\Model\\Resolver\\Product")
}

type AiChatTurn {
    user_message: AiChatMessage!
    assistant_message: AiChatMessage!
    request_uid: String
    email_required: Boolean!
}

type RestoreAiPreparedCartOutput {
    cart_url: String!
}
