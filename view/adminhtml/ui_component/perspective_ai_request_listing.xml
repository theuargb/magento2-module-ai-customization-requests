<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">perspective_ai_request_listing.perspective_ai_request_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>perspective_ai_request_columns</spinner>
        <deps>
            <dep>perspective_ai_request_listing.perspective_ai_request_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="perspective_ai_request_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">request_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Perspective_AiCustomizationRequests::requests</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="perspective_ai_request_listing_data_source">
            <settings>
                <requestFieldName>request_id</requestFieldName>
                <primaryFieldName>request_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="perspective_ai_request_columns">
        <column name="request_id">
            <settings>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="request_uid">
            <settings>
                <label translate="true">UID</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="customer_email">
            <settings>
                <label translate="true">Customer Email</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="base_product_sku">
            <settings>
                <label translate="true">Base SKU</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <label translate="true">Status</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <options class="Perspective\AiCustomizationRequests\Model\Source\RequestStatus"/>
            </settings>
        </column>
        <column name="summary">
            <settings>
                <label translate="true">Summary</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <label translate="true">Created</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <actionsColumn name="actions" class="Perspective\AiCustomizationRequests\Ui\Component\Listing\Column\RequestActions">
            <settings>
                <indexField>request_id</indexField>
                <label translate="true">Actions</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
